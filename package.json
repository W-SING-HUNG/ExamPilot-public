{
  "name": "exampilot-xigai",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "postinstall": "node tools/bank-local.mjs --ensure",
    "dev": "node tools/dev.mjs",
    "dev:frontend": "npm run bank:ensure && vite",
    "build": "npm run bank:ensure && tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "test": "npm run bank:ensure && node tools/web/build-web.mjs --demo && node tools/web/generate-worker-assets.mjs && vitest run",
    "test:watch": "vitest",
    "test:ai": "node tests/ai-proxy.test.mjs",
    "test:ai-stream": "node tests/ai-stream.test.mjs",
    "test:ai-security": "node tests/ai-security.test.mjs",
    "test:ai:all": "node tests/ai-proxy.test.mjs && node tests/ai-stream.test.mjs && node tests/ai-security.test.mjs",
    "test:browser": "node tests/browser.test.mjs",
    "test:browser:phase2": "node tests/phase2-ui.test.mjs",
    "test:browser:phase3": "node tests/phase3-ui.test.mjs",
    "test:public-info": "node tests/public-info-check.test.mjs",
    "test:release": "node tests/verify-release.test.mjs",
    "test:ui-guards": "node tests/ui-source-guards.test.mjs",
    "test:all": "vitest run && node tests/ai-proxy.test.mjs && node tests/ai-stream.test.mjs && node tests/ai-security.test.mjs && node tests/browser.test.mjs",
    "typecheck": "npm run bank:ensure && tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public-info": "node tools/public-info-check.mjs",
    "check:public-info:worktree": "node tools/public-info-check.mjs --worktree",
    "verify:release": "node tools/verify-release.mjs",
    "build:public": "node tools/bank-local.mjs --public && tsc -b && vite build && node tools/verify-release.mjs",
    "parse:bank": "py -X utf8 tools/parse_bank.py",
    "bank:local": "node tools/bank-local.mjs",
    "bank:ensure": "node tools/bank-local.mjs --ensure",
    "bank:public": "node tools/bank-local.mjs --public",
    "test:ui-verify": "node tests/ui-behaviour-verify.mjs && node tests/import-preview-verify.mjs",
    "build:web": "node tools/web/build-web.mjs",
    "build:web:demo": "node tools/web/build-web.mjs --demo",
    "web:verify": "node tools/web/verify-web.mjs",
    "web:check": "node tools/web/runtime-check.mjs",
    "web:deploy": "node tools/web/deploy-web.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
