# 统一行尾：仓库内一律使用 LF，避免跨平台 diff 噪音。
# 详见 https://git-scm.com/docs/gitattributes
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
