# ============================================================
# ExamPilot AI 网关配置（示例文件 —— 只含占位符，绝无真实密钥）
#
# 用法：复制为 .env 后填写，或直接设置同名环境变量。
#   cp .env.example .env
#
# 注意：.env 已被 .gitignore 忽略，不会被提交。
# 你也可以在应用「AI 助手」页面填写，配置会写入 server/ai-config.json（同样被忽略）。
# ============================================================

# AI 网关地址（OpenAI 兼容协议，必须以 /chat/completions 收尾的 base URL）
AI_BASE_URL=https://your-gateway.example.com/v1

# API Key —— 仅保存在服务端，不会进入前端代码或构建产物
AI_API_KEY=your-api-key-here

# 模型名称
AI_MODEL=your-model-name

# 请求超时（毫秒）
AI_TIMEOUT_MS=60000

# 单次请求最大输出 token
AI_MAX_TOKENS=2048

# AI 代理服务端口
AI_PORT=8787
